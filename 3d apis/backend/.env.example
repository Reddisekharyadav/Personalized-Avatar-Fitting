# ============================================
# Backend Environment Variables - TEMPLATE
# ============================================
# INSTRUCTIONS:
# 1. Copy this file to .env in the same directory
# 2. Replace all placeholder values with your actual credentials
# 3. NEVER commit the .env file to git!

# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name?retryWrites=true&w=majority&appName=appname
# Example: mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority

# Ready Player Me API
RPM_API_KEY=your_rpm_api_key_here
# Get your API key from: https://readyplayer.me/developers
RPM_APP_ID=your_rpm_app_id
RPM_PARTNER=your_rpm_partner_subdomain
RPM_ORGANIZATION_ID=your_rpm_organization_id

# Sketchfab API
SKETCHFAB_API_TOKEN=your_sketchfab_api_token
# Get your token from: https://sketchfab.com/settings/password

# 3D Model Generation Services
MESHY_API_KEY=your_meshy_api_key
# Get your API key from: https://meshy.ai
TRIPO_API_KEY=your_tripo_api_key
# Get your API key from: https://www.tripo3d.ai

# Hugging Face API (for AI models)
HUGGINGFACE_API_TOKEN=your_huggingface_token
# Get your token at: https://huggingface.co/settings/tokens (FREE!)

# OpenAI API (if using GPT models)
# OPENAI_API_KEY=your_openai_api_key
# Get your API key from: https://platform.openai.com/api-keys

# Replicate API (for AI model hosting)
REPLICATE_API_TOKEN=your_replicate_token
# Get your token from: https://replicate.com/account/api-tokens

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret for Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
# Generate a secure random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Storage Configuration
USE_GRIDFS=true
GRIDFS_BUCKET=uploads
# Set to true to use MongoDB GridFS for file storage instead of AWS S3

# AWS S3 Configuration (Optional - only if USE_GRIDFS=false)
# S3_BUCKET=your-s3-bucket-name
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
