# ============================================
# Frontend Environment Variables - TEMPLATE
# ============================================
# INSTRUCTIONS:
# 1. Copy this file to .env.local in the same directory
# 2. Replace all placeholder values with your actual credentials
# 3. NEVER commit .env.local to git!

# Sketchfab API Configuration
NEXT_PUBLIC_SKETCHFAB_API_KEY=your_sketchfab_api_token_here
# Get your token from: https://sketchfab.com/settings/password
# Note: This will be exposed to the browser (NEXT_PUBLIC_* variables are)

# Ready Player Me Configuration
NEXT_PUBLIC_RPM_SUBDOMAIN=your_rpm_subdomain
# Your RPM subdomain (e.g., if your URL is yourname-abc123.readyplayer.me, use "yourname-abc123")

# Debug Mode
NEXT_PUBLIC_RPM_DEBUG=false
# Set to true for development debugging

# API Backend URL
NEXT_PUBLIC_API_URL=http://localhost:5000
# For production: https://your-backend-api.com
