# ============================================
# RPM Avatar & Asset Manager - Environment Variables
# ============================================

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/virtualdressing
# Production example: mongodb+srv://username:password@cluster.mongodb.net/database

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# Generate a secure random string: openssl rand -base64 32

# AWS S3 Configuration (for avatar & asset storage)
S3_BUCKET=your-s3-bucket-name
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Ready Player Me Integration
RPM_API_KEY=your-rpm-developer-api-key
# Get your API key from: https://readyplayer.me/developers
RPM_ASSET_UPLOAD_ENDPOINT=https://api.readyplayer.me/v1/assets
# Check RPM docs for the latest endpoint URL

# Application Configuration
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
# Production: NODE_ENV=production, APP_ORIGIN=https://yourdomain.com

# Server Configuration
PORT=5000

# Optional: Frontend Environment Variables (create frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:5000
# NEXT_PUBLIC_RPM_CREATOR_URL=https://demo.readyplayer.me/avatar?frameApi
